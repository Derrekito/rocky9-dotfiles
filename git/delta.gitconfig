# delta as the pager, Rose Pine Moon colors. install.sh includes this file
# only when delta is installed, so git still works without it.

[core]
  pager = delta

[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true
	syntax-theme = base16
	# Rose Pine Moon palette
	minus-style                   = syntax "#44324f"
	minus-emph-style              = syntax "#6b3a5a"
	minus-non-emph-style          = syntax "#44324f"
	minus-empty-line-marker-style = syntax "#44324f"
	plus-style                    = syntax "#2d4152"
	plus-emph-style               = syntax "#2d5a6e"
	plus-non-emph-style           = syntax "#2d4152"
	plus-empty-line-marker-style  = syntax "#2d4152"
	map-styles                    = bold purple => syntax "#44324f", bold cyan => syntax "#2d4152"
	line-numbers-minus-style      = "#eb6f92" "#44324f"
	line-numbers-plus-style       = "#9ccfd8" "#2d4152"
	line-numbers-zero-style       = "#6e6a86" "#2a273f"
	line-numbers-left-style       = "#6e6a86"
	line-numbers-right-style      = "#6e6a86"
	file-style                    = "#c4a7e7" bold
	file-decoration-style         = "#44415a" ol
	hunk-header-style             = "#908caa" bold
	hunk-header-decoration-style  = "#44415a" box
	hunk-header-file-style        = "#c4a7e7"
	hunk-header-line-number-style = "#f6c177"
	blame-code-style              = syntax
	blame-palette                 = "#2a273f" "#26233a"
